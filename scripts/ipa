#!/usr/bin/env bash
# ipa-build 入口。Linux / macOS 用这个，Windows 用同目录的 ipa.ps1。

set -e

here="$(cd "$(dirname "$0")" && pwd)"
tc="${IPA_HOME:-$HOME/.ipa-toolchain}"
[ -f "$tc/env.sh" ] && . "$tc/env.sh"
sdk="${IPA_SDK:-$tc/sdk/iPhoneOS16.5.sdk}"
ldid="${IPA_LDID:-$tc/bin/ldid}"

die() { echo "$*" >&2; exit 1; }
need_ldid() { [ -x "$ldid" ] || die "没找到 ldid，先跑 scripts/bootstrap.sh"; }

zsign_bin() {
  if [ -n "${IPA_ZSIGN:-}" ]; then echo "$IPA_ZSIGN"; return; fi
  if [ -x "$tc/bin/zsign" ]; then echo "$tc/bin/zsign"; return; fi
  command -v zsign 2>/dev/null || true
}

# 有 p12 就走 zsign 真证书签名，没 p12 的地方还是走 ldid 伪签
sign_with_cert() {
  local in="$1" out="$2"
  local z; z="$(zsign_bin)"
  [ -n "$z" ] || die "证书签名要用 zsign，这台机器上没找到。把 zsign 放到 $tc/bin/ 或 PATH 里再来"
  [ -f "$p12" ] || die "找不到证书: $p12"
  [ -n "$prov" ] || die "证书签名还得给描述文件: --prov xxx.mobileprovision"
  [ -f "$prov" ] || die "找不到描述文件: $prov"
  local a=(-k "$p12" -m "$prov")
  [ -n "$pwd_" ] && a+=(-p "$pwd_")
  "$z" "${a[@]}" -o "$out" "$in" || die "zsign 签名失败，多半是 p12 密码不对，或者 bundle id 跟描述文件对不上"
}

plist_get() {
  local dir="$1" key="$2"
  python3 - "$dir/Info.plist" "$key" 2>/dev/null <<'PY' || true
import plistlib, sys
try:
    with open(sys.argv[1], 'rb') as f:
        d = plistlib.load(f)
    v = d.get(sys.argv[2])
    if v is not None:
        print(v)
except Exception:
    pass
PY
}

plist_set() {
  local dir="$1"; shift
  python3 - "$dir/Info.plist" "$@" <<'PY'
import plistlib, sys
path, pairs = sys.argv[1], sys.argv[2:]
with open(path, 'rb') as f:
    d = plistlib.load(f)
for p in pairs:
    k, _, v = p.partition('=')
    if k == 'CFBundleVersion' and v.isdigit():
        v = int(v)
    d[k] = v
with open(path, 'wb') as f:
    plistlib.dump(d, f)
PY
}

zip_payload() {
  local out="$1" root="$2"
  case "$out" in /*) ;; *) out="$PWD/$out";; esac
  mkdir -p "$(dirname "$out")"
  rm -f "$out"
  ( cd "$root" && zip -qr "$out" Payload )
  echo "$out" > "$root/.outpath"
}

# Info.plist 里的 CFBundleExecutable 和实际文件名对不上时（手改过、重打包过），
# 就按 Mach-O 魔数找一个真正的可执行文件
find_exe() {
  local app="$1" e
  e="$(plist_get "$app" CFBundleExecutable)"
  if [ -n "$e" ] && [ -f "$app/$e" ]; then echo "$e"; return; fi
  local f mag
  for f in "$app"/*; do
    [ -f "$f" ] || continue
    mag="$(head -c 4 "$f" | od -An -tx1 | tr -d ' \n')"
    case "$mag" in
      cffaedfe|cefaedfe) basename "$f"; return;;
    esac
  done
  echo ""
}

find_app() {
  find "$1" -maxdepth 3 -name '*.app' -type d | head -1
}

cmd_doctor() {
  printf '%-9s %s\n' clang "$(command -v clang >/dev/null && clang --version | head -1 | sed 's/.*version //' || echo 缺)"
  printf '%-9s %s\n' ld64.lld "$(command -v ld64.lld >/dev/null && echo ok || echo 缺)"
  printf '%-9s %s\n' sdk "$([ -d "$sdk" ] && echo "$sdk" || echo 缺)"
  printf '%-9s %s\n' ldid "$([ -x "$ldid" ] && echo "$ldid" || echo 缺)"
  printf '%-9s %s\n' 系统 "$(uname -s)"
}

cmd_info() {
  local t="$1" orig="$1" tmp=""
  [ -e "$t" ] || die "没有这个路径: $t"
  case "$t" in
    *.ipa) tmp="$(mktemp -d)"; unzip -q "$t" -d "$tmp"; t="$(find_app "$tmp")";;
  esac
  [ -d "$t" ] || die "既不是 .app 也不是 .ipa"

  local exe; exe="$(find_exe "$t")"
  [ -n "$exe" ] || exe="$(basename "$t" .app)"

  echo "位置     $orig"
  echo "可执行   $exe"
  echo "标识符   $(plist_get "$t" CFBundleIdentifier)"
  echo "版本     $(plist_get "$t" CFBundleShortVersionString) build $(plist_get "$t" CFBundleVersion)"
  echo "最低系统 $(plist_get "$t" MinimumOSVersion)"
  if [ -f "$t/$exe" ]; then
    echo "架构     $(file "$t/$exe" | sed 's/^[^:]*: //')"
    echo "大小     $(du -h "$t/$exe" | cut -f1)"
    if "$ldid" -h "$t/$exe" 2>/dev/null | grep -q CodeDirectory; then
      echo "签名     有 CodeDirectory，是伪签名"
    else
      echo "签名     没签"
    fi
  fi
  [ -n "$tmp" ] && rm -rf "$tmp"
  true
}

cmd_build() {
  shift
  local src="${1:-}"; [ -n "$src" ] || die "用法: ipa build 源码目录 --name 名字 --bundle-id com.a.b"
  shift
  [ -d "$src" ] || die "没有这个目录: $src"
  command -v clang >/dev/null || die "没有 clang，先跑 scripts/bootstrap.sh"
  [ -d "$sdk" ] || die "没有 SDK，先跑 scripts/bootstrap.sh"

  local name="" bid="com.example.app" minios="14.0" ent="" icon="" out="" fw=()
  local p12="" prov="" pwd_=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2;;
      --bundle-id) bid="$2"; shift 2;;
      --min-ios) minios="$2"; shift 2;;
      --entitlements) ent="$2"; shift 2;;
      --icon) icon="$2"; shift 2;;
      --framework) fw+=(-framework "$2"); shift 2;;
      --p12) p12="$2"; shift 2;;
      --prov) prov="$2"; shift 2;;
      --password|--pass) pwd_="$2"; shift 2;;
      -o) out="$2"; shift 2;;
      *) die "不认识的参数: $1";;
    esac
  done
  [ -n "$name" ] || name="$(basename "$src")"
  [ -n "$out" ] || out="$PWD/dist/$name.ipa"

  local work="$PWD/.build/$name"
  local app="$work/Payload/$name.app"
  rm -rf "$work"; mkdir -p "$app"

  local files=() f
  while IFS= read -r f; do files+=("$f"); done < <(find "$src" -maxdepth 2 -type f \( -name '*.m' -o -name '*.mm' -o -name '*.c' -o -name '*.cpp' \))
  [ ${#files[@]} -gt 0 ] || die "$src 里没有 .m/.mm/.c/.cpp"

  # 碰了 UIKit 才链 UIKit，不然白拉一堆依赖
  if [ ${#fw[@]} -eq 0 ]; then
    if grep -rq "UIKit/" "$src" 2>/dev/null; then
      fw=(-framework UIKit -framework Foundation)
    else
      fw=(-framework Foundation)
    fi
  fi

  local arc=()
  for f in "${files[@]}"; do
    case "$f" in *.m|*.mm) arc=(-fobjc-arc); break;; esac
  done

  echo "编译 ${#files[@]} 个文件，arm64 ios$minios"
  clang -target "arm64-apple-ios$minios" -isysroot "$sdk" \
        -F "$sdk/System/Library/Frameworks" \
        -fuse-ld=lld -O2 -fPIC "${arc[@]}" "${fw[@]}" \
        -o "$app/$name" "${files[@]}"

  cp "$here/templates/Info.plist" "$app/Info.plist"
  sed -i.bak "s|@NAME@|$name|g; s|@BUNDLEID@|$bid|g; s|@MINIOS@|$minios|g" "$app/Info.plist"
  rm -f "$app/Info.plist.bak"
  [ -n "$icon" ] && [ -f "$icon" ] && cp "$icon" "$app/AppIcon60x60@2x.png"

  chmod +x "$app/$name"
  if [ -z "$p12" ]; then
    need_ldid
    if [ -n "$ent" ] && [ -f "$ent" ]; then
      "$ldid" -S"$ent" "$app/$name" || die "ldid 签名失败"
    else
      "$ldid" -S "$app/$name" || die "ldid 签名失败"
    fi
  fi

  local tmpipa="$out.tmp.ipa"
  zip_payload "$tmpipa" "$work"
  if [ -n "$p12" ]; then
    sign_with_cert "$tmpipa" "$out"
    rm -f "$tmpipa"
  else
    mv -f "$tmpipa" "$out"
  fi
  echo "产物 $out"
}

cmd_pack() {
  shift
  local src="${1:-}"; [ -n "$src" ] || die "用法: ipa pack 某.app 或 含 Payload 的目录 [-o 输出.ipa]"
  shift
  [ -e "$src" ] || die "没有这个路径: $src"

  local out="" bid="" name="" version="" icon="" p12="" prov="" pwd_=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -o) out="$2"; shift 2;;
      --bundle-id) bid="$2"; shift 2;;
      --name) name="$2"; shift 2;;
      --version) version="$2"; shift 2;;
      --icon) icon="$2"; shift 2;;
      --p12) p12="$2"; shift 2;;
      --prov) prov="$2"; shift 2;;
      --password|--pass) pwd_="$2"; shift 2;;
      *) die "不认识的参数: $1";;
    esac
  done

  local work; work="$(mktemp -d)"; mkdir -p "$work/Payload"
  if [ -d "$src" ] && [ "$(basename "$src")" = "Payload" ]; then
    cp -r "$src/." "$work/Payload/"
  else
    cp -r "$src" "$work/Payload/"
  fi

  local app; app="$(find "$work/Payload" -maxdepth 1 -name '*.app' -type d | head -1)"
  [ -n "$app" ] || die "Payload 里没有 .app"

  local pairs=()
  [ -n "$bid" ] && pairs+=("CFBundleIdentifier=$bid")
  [ -n "$name" ] && pairs+=("CFBundleDisplayName=$name" "CFBundleExecutable=$name")
  [ -n "$version" ] && pairs+=("CFBundleShortVersionString=$version")
  [ ${#pairs[@]} -gt 0 ] && plist_set "$app" "${pairs[@]}"
  [ -n "$icon" ] && [ -f "$icon" ] && cp "$icon" "$app/AppIcon60x60@2x.png"

  local exe; exe="$(find_exe "$app")"
  [ -n "$exe" ] || exe="$(basename "$app" .app)"
  if [ -n "$name" ] && [ "$exe" != "$name" ] && [ -f "$app/$exe" ]; then
    mv "$app/$exe" "$app/$name"
    exe="$name"
  fi
  [ -z "$out" ] && out="$PWD/dist/$(basename "$app" .app).ipa"

  if [ -z "$p12" ] && [ -f "$app/$exe" ] && [ -x "$ldid" ]; then
    rm -rf "$app/_CodeSignature"
    "$ldid" -S "$app/$exe" || echo "签名没成功，包还是打出来，装不装得上另说"
  fi

  local tmpipa="$out.tmp.ipa"
  zip_payload "$tmpipa" "$work"
  if [ -n "$p12" ]; then
    sign_with_cert "$tmpipa" "$out"
    rm -f "$tmpipa"
  else
    mv -f "$tmpipa" "$out"
  fi
  rm -rf "$work"
  echo "产物 $out"
}

cmd_resign() {
  shift
  local src="${1:-}"; [ -n "$src" ] || die "用法: ipa resign 某.ipa 或 某.app [-o 输出.ipa]"
  shift
  [ -e "$src" ] || die "没有这个路径: $src"

  local out="" ent="" bid="" p12="" prov="" pwd_=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -o) out="$2"; shift 2;;
      --entitlements) ent="$2"; shift 2;;
      --bundle-id) bid="$2"; shift 2;;
      --p12) p12="$2"; shift 2;;
      --prov) prov="$2"; shift 2;;
      --password|--pass) pwd_="$2"; shift 2;;
      *) die "不认识的参数: $1";;
    esac
  done

  local work; work="$(mktemp -d)"
  case "$src" in
    *.ipa) unzip -q "$src" -d "$work";;
    *.app) mkdir -p "$work/Payload"; cp -r "$src" "$work/Payload/";;
    *) die "只认 .ipa 和 .app";;
  esac

  local app; app="$(find "$work/Payload" -maxdepth 1 -name '*.app' -type d | head -1)"
  [ -n "$app" ] || die "包里没有 .app"

  [ -n "$bid" ] && plist_set "$app" "CFBundleIdentifier=$bid"
  rm -rf "$app/_CodeSignature"

  local exe; exe="$(find_exe "$app")"
  [ -z "$exe" ] && die "这个 app 里没找到可执行文件"
  if [ -z "$p12" ]; then
    need_ldid
    if [ -n "$ent" ] && [ -f "$ent" ]; then
      "$ldid" -S"$ent" "$app/$exe"
    else
      "$ldid" -S "$app/$exe"
    fi
    # 包里带的 dylib 也得签，不然启动就崩
    find "$app" -name '*.dylib' -type f 2>/dev/null | while read -r d; do "$ldid" -S "$d" 2>/dev/null || true; done
  fi

  [ -z "$out" ] && out="${src%.*}_resigned.ipa"
  local tmpipa="$out.tmp.ipa"
  zip_payload "$tmpipa" "$work"
  if [ -n "$p12" ]; then
    sign_with_cert "$tmpipa" "$out"
    rm -f "$tmpipa"
  else
    mv -f "$tmpipa" "$out"
  fi
  rm -rf "$work"
  echo "产物 $out"
}

case "${1:-}" in
  doctor) cmd_doctor;;
  info) shift; cmd_info "$@";;
  build) cmd_build "$@";;
  pack) cmd_pack "$@";;
  resign) cmd_resign "$@";;
  *) sed -n '2p' "$0"; echo; echo "  doctor   看环境齐不齐"
     echo "  info     看 ipa/app 的标识、版本、架构、签没签"
     echo "  build    .m/.c 编成 ipa，需要 clang 和 SDK"
     echo "  pack     .app 打成 ipa，可改标识/显示名/版本/图标"
     echo "  resign   已有的 ipa 或 app 重做伪签名，可换标识";;
esac

#!/usr/bin/env bash
# ipa-build 入口。Linux / macOS 用这个，Windows 用同目录的 ipa.ps1。
set -e

here="$(cd "$(dirname "$0")" && pwd)"
root="$(dirname "$here")"
tc="${IPA_HOME:-$HOME/.ipa-toolchain}"
[ -f "$tc/env.sh" ] && . "$tc/env.sh"
sdk="${IPA_SDK:-$tc/sdk/iPhoneOS16.5.sdk}"
ldid="${IPA_LDID:-$tc/bin/ldid}"

app_version() {
  sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$root/package.json" 2>/dev/null | head -1
}

# 只判断 a 是否比 b 旧，输出 1/0。不用 sort -V：macOS 的 sort 没有这个开关。
version_lt() {
  awk -v a="$1" -v b="$2" 'BEGIN{
    n=split(a,x,"."); m=split(b,y,".");
    for(i=1;i<=4;i++){ p=x[i]+0; q=y[i]+0;
      if(p<q){print 1; exit} if(p>q){print 0; exit} }
    print 0
  }'
}

# 工具链没铺过就自己铺，不等用户跑 bootstrap。SDK/ldid/zsign 全在 vendor 里，不联网；
# 编译器那一步要联网或要 sudo，失败会让 bootstrap 自己报，不在这里吞掉。
ensure_toolchain() {
  [ -d "$sdk" ] && [ -x "$ldid" ] && [ -f "$tc/env.sh" ] && return 0
  echo "工具链还没铺，先装一次（只装一次，之后走缓存）" >&2
  bash "$root/scripts/bootstrap.sh" >&2 || die "铺环境失败，见上面的报错"
  [ -f "$tc/env.sh" ] && . "$tc/env.sh"
  sdk="${IPA_SDK:-$tc/sdk/iPhoneOS16.5.sdk}"
  ldid="${IPA_LDID:-$tc/bin/ldid}"
}

die() { echo "$*" >&2; exit 1; }
need_ldid() { [ -x "$ldid" ] || die "没找到 ldid。跑 scripts/bootstrap.sh 编一下，出包时也会自动铺"; }
need_py() { command -v python3 >/dev/null || die "缺 python3，改 plist 要用它（bootstrap 不装系统包，请自行 apt/dnf/pacman 装）"; }

zsign_bin() {
  if [ -n "${IPA_ZSIGN:-}" ]; then echo "$IPA_ZSIGN"; return; fi
  if [ -x "$tc/bin/zsign" ]; then echo "$tc/bin/zsign"; return; fi
  command -v zsign 2>/dev/null || true
}

# 密码优先走环境变量，命令行参数只做兼容
cert_pass() {
  local cli="$1"
  if [ -n "$cli" ]; then
    echo "提示：--password 会进 shell 历史和进程列表，建议改用 IPA_CERT_PASSWORD" >&2
    printf '%s' "$cli"; return
  fi
  printf '%s' "${IPA_CERT_PASSWORD:-}"
}

# 有 p12 就走 zsign 真签名，没 p12 的地方还是走 ldid 伪签
sign_with_cert() {
  local in="$1" out="$2"
  local z; z="$(zsign_bin)"
  [ -n "$z" ] || die "证书签名要用 zsign，这台机器上没找到。把 zsign 放到 $tc/bin/ 或 PATH 里再来"
  [ -f "$p12" ] || die "找不到证书: $p12"
  [ -n "$prov" ] || die "证书签名还得给描述文件: --prov xxx.mobileprovision"
  [ -f "$prov" ] || die "找不到描述文件: $prov"
  local a=(-k "$p12" -m "$prov")
  [ -n "$pwd_" ] && a+=(-p "$pwd_")
  "$z" "${a[@]}" -o "$out" "$in" || die "zsign 签名失败，多半是 p12 密码不对，或者 bundle id 跟描述文件对不上"
}

plist_get() {
  local dir="$1" key="$2"
  python3 - "$dir/Info.plist" "$key" <<'PY' 2>/dev/null || true
import plistlib, sys
try:
    with open(sys.argv[1], 'rb') as f:
        d = plistlib.load(f)
    print(d.get(sys.argv[2], '') or '')
except Exception:
    pass
PY
}

# 只改/加字符串键；数字也按字符串写，CFBundleVersion 在规范里是字符串
plist_set() {
  local dir="$1"; shift
  python3 - "$dir/Info.plist" "$@" <<'PY'
import plistlib, sys
path, pairs = sys.argv[1], sys.argv[2:]
with open(path, 'rb') as f:
    d = plistlib.load(f)
for p in pairs:
    k, _, v = p.partition('=')
    d[k] = v
with open(path, 'wb') as f:
    plistlib.dump(d, f)
PY
}

# 架构 + 签名状态，一次读完。不再用 file / 字符串搜索判断
macho_report() {
  python3 - "$1" <<'PY'
import struct, sys

CPU = {16777228: 'arm64', 16777223: 'x86_64', 12: 'armv7', 7: 'i386', 16777222: 'arm64_32'}

path = sys.argv[1]
try:
    fh = open(path, 'rb')
except Exception as e:
    print('读不了|%s' % e)
    sys.exit()
# 几百 MB 的二进制整读会把内存翻倍，这里只按偏移 seek 读
fh.seek(0, 2)
size = fh.tell()

def rd(off, n, endian):
    if off is None or off < 0 or off + n > size:
        return None
    fh.seek(off)
    raw = fh.read(n)
    if len(raw) != n:
        return None
    fmt = ('>' if endian == 'be' else '<') + ('I' if n == 4 else 'Q')
    return struct.unpack(fmt, raw)[0]

def sig_state(base, _fat_endian=None):
    # slice 自己的字节序看它自己的 magic，不能沿用 fat 头的字节序
    raw = rd(base, 4, 'le')
    if raw in (0xfeedfacf, 0xfeedface):
        endian = 'le'
    elif raw in (0xcefaedfe, 0xcffaedfe):
        endian = 'be'
    else:
        return None
    magic = rd(base, 4, endian)
    if magic == 0xfeedfacf:
        hsz = 32
    elif magic == 0xfeedface:
        hsz = 28
    else:
        return None
    ncmds = rd(base + 16, 4, endian)
    sizeofcmds = rd(base + 20, 4, endian)
    if ncmds > 4096 or sizeofcmds > 1048576:
        return None
    pos, end = base + hsz, base + hsz + sizeofcmds
    sigoff = None
    while pos + 8 <= end and pos + 8 <= size:
        cmd, cmdsz = rd(pos, 4, endian), rd(pos + 4, 4, endian)
        if cmdsz is None or cmdsz < 8:
            break
        if cmd == 0x1d and pos + 16 <= size:
            # dataoff 相对 slice 起点，fat 里要加上 base
            sigoff = base + rd(pos + 8, 4, endian)
        pos += cmdsz
    if sigoff is None or sigoff + 12 > size:
        return None
    # CodeSignature 的 SuperBlob 在文件里固定大端（FA DE 0C C0），
    # 跟 slice 自己是小端还是大端无关，这里不能跟着 slice 走
    if rd(sigoff, 4, 'be') != 0xfade0cc0:
        return None
    count = rd(sigoff + 4, 4, 'be')
    types = [rd(sigoff + 8 + i * 8, 4, 'be') for i in range(min(count, 20))]
    if 0x10000 in types:
        return 'cms'
    if 0 in types:
        return 'adhoc'
    return None

# 按“小端读出的值”判断：标准 fat 头是 CA FE BA BE，小端读出 0xBEBAFECA，字段按大端；
# 0xCAFEBABE 是字节交换变体 FAT_CIGAM，字段按小端
FAT = {
    0xBEBAFECA: ('be', 20),
    0xBFBAFECA: ('be', 32),
    0xCAFEBABE: ('le', 20),
    0xCAFEBABF: ('le', 32),
}

magic = rd(0, 4, 'le')
archs = []
sig = None
if magic in (0xfeedface, 0xfeedfacf):
    archs = [CPU.get(rd(4, 4, 'le'), '?')]
    sig = sig_state(0, 'le')
elif magic in (0xcefaedfe, 0xcffaedfe):
    archs = [CPU.get(rd(4, 4, 'be'), '?')]
    sig = sig_state(0, 'be')
elif magic in FAT:
    endian, entSize = FAT[magic]
    nfat = rd(4, 4, endian) or 0
    if nfat <= 20:
        for i in range(nfat):
            e = 8 + i * entSize
            if e + entSize > size:
                break
            archs.append(CPU.get(rd(e, 4, endian), '?'))
            off = rd(e + 8, 8 if entSize == 32 else 4, endian)
            if off is not None and off < size:
                st = sig_state(off)
                # 多个切片取最强的那个：任一有 CMS 就是真证书签名
                if st == 'cms' or (st and sig is None):
                    sig = st
    else:
        archs = ['不是 Mach-O']
else:
    archs = ['不是 Mach-O']

label = {'cms': '真证书签名（有 CMS）', 'adhoc': 'ad-hoc 伪签名（只有 CodeDirectory）', None: '没签'}[sig]
print('|'.join(['+'.join(archs) or '?', label]))
fh.close()
PY
}

# Info.plist 里的 CFBundleExecutable 和实际文件名对不上时（手改过、重打包过），
# 就按 Mach-O 魔数找一个真正的可执行文件
find_exe() {
  local app="$1" e
  e="$(plist_get "$app" CFBundleExecutable)"
  if [ -n "$e" ] && [ -f "$app/$e" ]; then echo "$e"; return; fi
  python3 - "$app" <<'PY' 2>/dev/null || true
import os, struct, sys
app = sys.argv[1]
# 32/64 位 Mach-O、标准 fat（小端读出 0xBEBAFECA）和字节交换变体
MAG = (0xfeedface, 0xfeedfacf, 0xcefaedfe, 0xcffaedfe, 0xbebafeca, 0xbfbafeca, 0xcafebabe, 0xcafebabf)
base = os.path.basename(app.rstrip('/'))
prefer = [base[:-4]] if base.endswith('.app') else []
names = sorted(os.listdir(app))
# 顶层常有 helper 之类的其他 Mach-O，app 同名的那份才是主程序，先试它
cand = [n for n in prefer if n in names] + [n for n in names if n not in prefer]
for name in cand:
    p = os.path.join(app, name)
    if not os.path.isfile(p):
        continue
    try:
        head = open(p, 'rb').read(4)
        m = struct.unpack('<I', head)[0]
        if m in (0xbebafeca, 0xbfbafeca):
            nfat = struct.unpack('>I', open(p, 'rb').read(8)[4:8])[0]
            if nfat > 20:
                continue
        elif m in (0xcafebabe, 0xcafebabf):
            # 也可能是 Java 类，看 nfat 是否像一个正常值
            nfat = struct.unpack('<I', open(p, 'rb').read(8)[4:8])[0]
            if nfat > 20:
                continue
    except Exception:
        continue
    if m in MAG:
        print(name)
        break
PY
}

find_app() {
  find "$1" -maxdepth 3 -name '*.app' -type d 2>/dev/null | awk '{ print length($0), $0 }' | sort -n | head -1 | cut -d' ' -f2-
}

cmd_doctor() {
  printf '%-9s %s\n' 版本 "$(app_version)"
  printf '%-9s %s\n' 工具链 "$([ -f "$tc/env.sh" ] && echo "$tc" || echo "没铺（出包时会自动装，或先跑 scripts/bootstrap.sh）")"
  local v
  v="$(command -v clang >/dev/null 2>&1 && clang --version 2>/dev/null | head -1 | sed 's/.*version //' || echo 缺)"
  printf '%-9s %s\n' clang "$v"
  printf '%-9s %s\n' ld64.lld "$(command -v ld64.lld >/dev/null 2>&1 && echo ok || echo 缺)"
  printf '%-9s %s\n' sdk "$([ -d "$sdk" ] && echo "$sdk" || echo 缺)"
  printf '%-9s %s\n' ldid "$([ -x "$ldid" ] && echo "$ldid" || echo 缺)"
  printf '%-9s %s\n' python3 "$(command -v python3 >/dev/null 2>&1 && echo ok || echo 缺)"
  printf '%-9s %s\n' zip "$(command -v zip >/dev/null 2>&1 && echo ok || echo 缺)"
  printf '%-9s %s\n' unzip "$(command -v unzip >/dev/null 2>&1 && echo ok || echo 缺)"
  printf '%-9s %s\n' 系统 "$(uname -s)"
  case "$(uname -s)" in
    Linux)
      if command -v apt-get >/dev/null 2>&1; then echo "包管理  apt（clang lld python3 zip unzip）"
      elif command -v dnf >/dev/null 2>&1; then echo "包管理  dnf（clang lld python3 zip unzip）"
      elif command -v pacman >/dev/null 2>&1; then echo "包管理  pacman（clang lld python zip unzip）"
      else echo "包管理  认不出，bootstrap 只支持 apt/dnf/pacman"; fi;;
  esac
}

cmd_info() {
  local t="$1" orig="$1" tmp=""
  [ -e "$t" ] || die "没有这个路径: $t"
  case "$t" in
    *.ipa) tmp="$(mktemp -d)"; unzip -q "$t" -d "$tmp"; t="$(find_app "$tmp")";;
  esac
  [ -d "$t" ] || die "既不是 .app 也不是 .ipa"

  local exe; exe="$(find_exe "$t")"
  [ -n "$exe" ] || exe="$(basename "$t" .app)"

  local bid ver build minos
  bid="$(plist_get "$t" CFBundleIdentifier)"
  ver="$(plist_get "$t" CFBundleShortVersionString)"
  build="$(plist_get "$t" CFBundleVersion)"
  minos="$(plist_get "$t" MinimumOSVersion)"

  echo "位置     $orig"
  echo "可执行   $exe"
  echo "标识符   $bid"
  echo "版本     $ver build $build"
  echo "最低系统 $minos"
  if [ -z "$bid$ver$minos" ]; then
    echo "plist    这几个键都读不出来：plist 可能损坏，也可能键名不是标准写法（bash 这边 bplist 本来就能读）"
  fi
  if [ -f "$t/$exe" ]; then
    local rep; rep="$(macho_report "$t/$exe")"
    echo "架构     ${rep%%|*}"
    echo "签名     ${rep#*|}"
    echo "大小     $(du -h "$t/$exe" | cut -f1)"
  fi
  [ -n "$tmp" ] && rm -rf "$tmp"
  true
}

cmd_build() {
  shift
  local src="${1:-}"; [ -n "$src" ] || die "用法: ipa build 源码目录 --name 名字 --bundle-id com.a.b"
  shift
  [ -d "$src" ] || die "没有这个目录: $src"
  command -v clang >/dev/null || die "没有 clang。跑 scripts/bootstrap.sh 装（Linux 走 apt，macOS 走 xcode-select + brew），装完再编"
  [ -d "$sdk" ] || die "没有 SDK，先跑 scripts/bootstrap.sh"

  local name="" bid="com.example.app" minios="14.0" ent="" icon="" out="" fw=()
  local p12="" prov="" pwd_cli=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2;;
      --bundle-id) bid="$2"; shift 2;;
      --min-ios) minios="$2"; shift 2;;
      --entitlements) ent="$2"; shift 2;;
      --icon) icon="$2"; shift 2;;
      --framework) fw+=(-framework "$2"); shift 2;;
      --p12) p12="$2"; shift 2;;
      --prov) prov="$2"; shift 2;;
      --password|--pass) pwd_cli="$2"; shift 2;;
      -o) out="$2"; shift 2;;
      *) die "不认识的参数: $1";;
    esac
  done
  pwd_="$(cert_pass "$pwd_cli")"
  [ -n "$name" ] || name="$(basename "$src")"
  [ -n "$out" ] || out="$PWD/dist/$name.ipa"

  local work="$PWD/.build/$name"
  local app="$work/Payload/$name.app"
  rm -rf "$work"; mkdir -p "$app"

  # 源码不限层级，跟 Windows 版保持一致
  local files=() f
  while IFS= read -r f; do files+=("$f"); done < <(find "$src" -type f \( -name '*.m' -o -name '*.mm' -o -name '*.c' -o -name '*.cpp' \) ! -path '*/.build/*')
  [ ${#files[@]} -gt 0 ] || die "$src 里没有 .m/.mm/.c/.cpp"

  if [ ${#fw[@]} -eq 0 ]; then
    if grep -rq "UIKit/" "$src" 2>/dev/null; then
      fw=(-framework UIKit -framework Foundation)
    else
      fw=(-framework Foundation)
    fi
  fi

  local arc=()
  for f in "${files[@]}"; do
    case "$f" in *.m|*.mm) arc=(-fobjc-arc); break;; esac
  done

  echo "编译 ${#files[@]} 个文件，arm64 ios$minios"
  clang -target "arm64-apple-ios$minios" -isysroot "$sdk" -F "$sdk/System/Library/Frameworks" -fuse-ld=lld -O2 -fPIC "${arc[@]}" "${fw[@]}" -o "$app/$name" "${files[@]}"

  # 模板填充走 python，名字里带 & < | 也不会把 plist 弄坏
  need_py
  python3 - "$here/templates/Info.plist" "$app/Info.plist" "$name" "$bid" "$minios" <<'PY'
import sys
from xml.sax.saxutils import escape
tpl, out, name, bid, minios = sys.argv[1:6]
s = open(tpl, encoding='utf-8').read()
for k, v in (('@NAME@', name), ('@BUNDLEID@', bid), ('@MINIOS@', minios)):
    s = s.replace(k, escape(v))
open(out, 'w', encoding='utf-8').write(s)
PY
  [ -n "$icon" ] && [ -f "$icon" ] && cp "$icon" "$app/AppIcon60x60@2x.png"
  chmod +x "$app/$name"

  if [ -z "$p12" ]; then
    need_ldid
    if [ -n "$ent" ] && [ -f "$ent" ]; then "$ldid" -S"$ent" "$app/$name" || die "ldid 签名失败"
    else "$ldid" -S "$app/$name" || die "ldid 签名失败"; fi
  fi

  local tmpipa="$out.tmp.ipa"
  zip_payload "$tmpipa" "$work"
  if [ -n "$p12" ]; then sign_with_cert "$tmpipa" "$out"; rm -f "$tmpipa"
  else mv -f "$tmpipa" "$out"; fi
  # 只删这次构建的目录，同 cwd 下别的 app 的中间产物不能连坐
  rm -rf "$work"; rmdir "$PWD/.build" 2>/dev/null || true
  echo "产物 $out"
}

zip_payload() {
  local out="$1" root="$2"
  case "$out" in /*) ;; *) out="$PWD/$out";; esac
  mkdir -p "$(dirname "$out")"
  rm -f "$out"
  # -y 保留符号链接，别把 .framework 里的链接展开成重复文件
  ( cd "$root" && zip -qry "$out" Payload )
}

cmd_pack() {
  shift
  local src="${1:-}"; [ -n "$src" ] || die "用法: ipa pack 某.app 或 含 Payload 的目录 [-o 输出.ipa]"
  shift
  [ -e "$src" ] || die "没有这个路径: $src"

  local out="" bid="" name="" version="" icon="" p12="" prov="" pwd_cli=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -o) out="$2"; shift 2;;
      --bundle-id) bid="$2"; shift 2;;
      --name) name="$2"; shift 2;;
      --version) version="$2"; shift 2;;
      --icon) icon="$2"; shift 2;;
      --p12) p12="$2"; shift 2;;
      --prov) prov="$2"; shift 2;;
      --password|--pass) pwd_cli="$2"; shift 2;;
      *) die "不认识的参数: $1";;
    esac
  done
  pwd_="$(cert_pass "$pwd_cli")"

  local work; work="$(mktemp -d)"; mkdir -p "$work/Payload"
  if [ -d "$src" ] && [ "$(basename "$src")" = "Payload" ]; then
    cp -r "$src/." "$work/Payload/"
  else
    cp -r "$src" "$work/Payload/"
  fi

  local app; app="$(find "$work/Payload" -maxdepth 1 -name '*.app' -type d | head -1)"
  if [ -z "$app" ]; then
    app="$(find "$work" -name '*.app' -type d | awk '{ print length($0), $0 }' | sort -n | head -1 | cut -d' ' -f2-)"
    [ -n "$app" ] || die "这棵树里没找到 .app。可以直接把 .app 本身当参数传进来"
    echo "给的目录里没有顶层 .app，改用找到的这个：$app"
  fi

  need_py
  local pairs=()
  [ -n "$bid" ] && pairs+=("CFBundleIdentifier=$bid")
  [ -n "$name" ] && pairs+=("CFBundleDisplayName=$name" "CFBundleExecutable=$name")
  [ -n "$version" ] && pairs+=("CFBundleShortVersionString=$version")
  if [ ${#pairs[@]} -gt 0 ]; then
    [ -f "$app/Info.plist" ] || die "$app 里没有 Info.plist"
    plist_set "$app" "${pairs[@]}"
  fi
  [ -n "$icon" ] && [ -f "$icon" ] && cp "$icon" "$app/AppIcon60x60@2x.png"

  local exe; exe="$(find_exe "$app")"
  [ -n "$exe" ] || exe="$(basename "$app" .app)"
  if [ -n "$name" ] && [ "$exe" != "$name" ] && [ -f "$app/$exe" ]; then
    mv "$app/$exe" "$app/$name"
    exe="$name"
  fi
  [ -z "$out" ] && out="$PWD/dist/${name:-$(basename "$app" .app)}.ipa"

  if [ -z "$p12" ] && [ -f "$app/$exe" ] && [ -x "$ldid" ]; then
    rm -rf "$app/_CodeSignature"
    "$ldid" -S "$app/$exe" || echo "签名没成功，包还是打出来，装不装得上另说"
  fi

  local tmpipa="$out.tmp.ipa"
  zip_payload "$tmpipa" "$work"
  if [ -n "$p12" ]; then sign_with_cert "$tmpipa" "$out"; rm -f "$tmpipa"
  else mv -f "$tmpipa" "$out"; fi
  rm -rf "$work"
  echo "产物 $out"
}

# 内嵌的 framework / appex / dylib 都得签，只签主程序启动就崩
sign_nested() {
  local app="$1" ent="$2" d
  if [ -d "$app/PlugIns" ]; then
    while IFS= read -r x; do
      local xe; xe="$(plist_get "$x" CFBundleExecutable)"
      [ -n "$xe" ] || xe="$(basename "$x" .appex)"
      # 扩展用自己的 entitlements（app groups 之类跟主 app 不一样），
      # 没有就裸签，别把主 app 的高权限项摊到扩展上
      local xent=""
      for cand in "$x/Entitlements.plist" "$(dirname "$x")/$(basename "$x" .appex).entitlements"; do
        [ -f "$cand" ] && { xent="$cand"; break; }
      done
      if [ -n "$xent" ]; then "$ldid" -S"$xent" "$x/$xe" || die "签 $x 失败"
      else "$ldid" -S "$x/$xe" || die "签 $x 失败"; fi
      find "$x" -name '*.dylib' -type f | while read -r d; do "$ldid" -S "$d" || true; done
    done < <(find "$app" -name '*.appex' -type d -not -path '*/Frameworks/*' 2>/dev/null)
  fi
  if [ -d "$app/Frameworks" ]; then
    while IFS= read -r fwdir; do
      local bin="$fwdir/$(basename "$fwdir" .framework)"
      [ -f "$bin" ] && { "$ldid" -S "$bin" || die "签 $bin 失败"; }
      find "$fwdir" -name '*.dylib' -type f | while read -r d; do "$ldid" -S "$d" || true; done
    done < <(find "$app/Frameworks" -maxdepth 1 -name '*.framework' -type d 2>/dev/null)
    find "$app/Frameworks" -maxdepth 1 -name '*.dylib' -type f | while read -r d; do "$ldid" -S "$d" || true; done
  fi
}

# 换主 id 时扩展的 id 要跟着换，真签要求 appex id 以主 app id 开头
retag_appex() {
  local app="$1" bid="$2" x eid pre
  # 用扩展自己的 bundle 名，不取旧 id 的最后一段：两个扩展末段同名会撞 id。
  # Watch 里的扩展要挂在 watchkitapp 下面。
  while IFS= read -r x; do
    eid="$(plist_get "$x" CFBundleIdentifier)"
    [ -n "$eid" ] || continue
    case "$x" in
      */Watch/*) pre="$bid.watchkitapp" ;;
      *) pre="$bid" ;;
    esac
    plist_set "$x" "CFBundleIdentifier=$pre.$(basename "$x" .appex)"
  done < <(find "$app" -name '*.appex' -type d 2>/dev/null)
  # Watch/<x>.app 自己也是一个要真签的包，id 得跟着主 app 走
  while IFS= read -r x; do
    eid="$(plist_get "$x" CFBundleIdentifier)"
    [ -n "$eid" ] || continue
    plist_set "$x" "CFBundleIdentifier=$bid.watchkitapp"
  done < <(find "$app" -path '*/Watch/*.app' -type d 2>/dev/null)
}

cmd_resign() {
  shift
  local src="${1:-}"; [ -n "$src" ] || die "用法: ipa resign 某.ipa 或 某.app [-o 输出.ipa]"
  shift
  [ -e "$src" ] || die "没有这个路径: $src"

  local out="" ent="" bid="" p12="" prov="" pwd_cli=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -o) out="$2"; shift 2;;
      --entitlements) ent="$2"; shift 2;;
      --bundle-id) bid="$2"; shift 2;;
      --p12) p12="$2"; shift 2;;
      --prov) prov="$2"; shift 2;;
      --password|--pass) pwd_cli="$2"; shift 2;;
      *) die "不认识的参数: $1";;
    esac
  done
  pwd_="$(cert_pass "$pwd_cli")"

  local work; work="$(mktemp -d)"
  case "$src" in
    *.ipa) unzip -q "$src" -d "$work";;
    *.app) mkdir -p "$work/Payload"; cp -r "$src" "$work/Payload/";;
    *) die "只认 .ipa 和 .app";;
  esac

  local app; app="$(find "$work/Payload" -maxdepth 1 -name '*.app' -type d | head -1)"
  [ -n "$app" ] || die "包里没有 .app"

  if [ -n "$bid" ]; then
    need_py
    plist_set "$app" "CFBundleIdentifier=$bid"
    retag_appex "$app" "$bid"
  fi
  rm -rf "$app/_CodeSignature"

  local exe; exe="$(find_exe "$app")"
  [ -z "$exe" ] && die "这个 app 里没找到可执行文件"
  if [ -z "$p12" ]; then
    need_ldid
    sign_nested "$app" "$ent"
    if [ -n "$ent" ] && [ -f "$ent" ]; then "$ldid" -S"$ent" "$app/$exe" || die "ldid 签名失败"
    else "$ldid" -S "$app/$exe" || die "ldid 签名失败"; fi
  fi

  local leaf; leaf="$(basename "$src")"; leaf="${leaf%.*}"
  [ -z "$out" ] && out="$PWD/dist/${leaf}_resigned.ipa"
  local tmpipa="$out.tmp.ipa"
  zip_payload "$tmpipa" "$work"
  if [ -n "$p12" ]; then sign_with_cert "$tmpipa" "$out"; rm -f "$tmpipa"
  else mv -f "$tmpipa" "$out"; fi
  rm -rf "$work"
  echo "产物 $out"
}

# 云更新：不用重装插件，直接从 npm 拿新版本的工具链，铺进现有的 ~/.ipa-toolchain。
# SDK、ldid、zsign 跟着换，用户已有的产物和证书不受影响。
cmd_update() {
  local mode="apply"
  [ "${1:-}" = "--check" ] && mode="check"
  local cur lat
  cur="$(app_version)"; [ -n "$cur" ] || cur="0.0.0"
  command -v curl >/dev/null 2>&1 || die "没有 curl，查不了新版"
  local meta
  meta="$(curl -fsSL --max-time 20 https://registry.npmjs.org/dsh-ipa-build/latest)" || die "查 npm 没通，网络问题，稍后再试"
  lat="$(printf '%s' "$meta" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p' | head -1)"
  [ -n "$lat" ] || die "npm 的返回里解析不出版本号"
  echo "插件 $cur，npm 上 $lat"
  if [ "$cur" = "$lat" ]; then echo "已经是最新"; return 0; fi
  if [ "$(version_lt "$cur" "$lat")" != "1" ]; then
    echo "本地比 npm 上的新（$cur），不动它"; return 0
  fi
  if [ "$mode" = "check" ]; then
    echo "有新版本: $lat"
    echo "工具链更新: scripts/ipa update"
    echo "插件本体更新: dsh plugin add dsh-ipa-build@$lat"
    return 0
  fi

  local url integ
  url="$(printf '%s' "$meta" | sed -n 's/.*"tarball":"\([^"]*\)".*/\1/p' | head -1)"
  integ="$(printf '%s' "$meta" | sed -n 's/.*"integrity":"\([^"]*\)".*/\1/p' | head -1)"
  [ -n "$url" ] || die "npm 没给 tarball 地址"
  local tgz="$tc/dsh-ipa-build-$lat.tgz"
  mkdir -p "$tc"
  echo "下载 $lat"
  curl -fsSL --max-time 900 -o "$tgz" "$url" || die "下载没成，重跑一次会接着来"
  if [ -z "$integ" ]; then
    echo "npm 没给 integrity，跳过哈希核对" >&2
  elif ! command -v openssl >/dev/null 2>&1; then
    echo "这台机器没有 openssl，跳过哈希核对（装一个再更新更稳）" >&2
  else
    local got
    got="sha512-$(openssl dgst -sha512 -binary "$tgz" | openssl base64 -A)"
    [ "$got" = "$integ" ] || { rm -f "$tgz"; die "包和 npm 上的哈希对不上，停了"; }
    echo "哈希核对通过"
  fi
  local dir="$tc/pkg/$lat"
  rm -rf "$dir"; mkdir -p "$dir"
  tar -xzf "$tgz" -C "$dir" --strip-components=1 || die "解包失败"
  echo "换工具链"
  IPA_HOME="$tc" bash "$dir/scripts/bootstrap.sh" || die "工具链没换完，旧的那套还在，能继续用"
  printf '%s\n' "$lat" > "$tc/VERSION"
  rm -f "$tgz"
  echo "工具链已到 $lat"
  echo "插件本体还需要宿主换：dsh plugin add dsh-ipa-build@$lat"
}

case "${1:-}" in
  doctor) cmd_doctor;;
  info) shift; cmd_info "$@";;
  build) ensure_toolchain; cmd_build "$@";;
  pack) ensure_toolchain; cmd_pack "$@";;
  resign) ensure_toolchain; cmd_resign "$@";;
  update) shift; cmd_update "$@";;
  *) sed -n '2p' "$0"; echo; echo "  doctor   看环境齐不齐"
     echo "  info     看 ipa/app 的标识、版本、架构、签没签"
     echo "  build    .m/.c 编成 ipa，需要 clang 和 SDK"
     echo "  pack     .app 打成 ipa，可改标识/显示名/版本/图标"
     echo "  resign   已有的 ipa 或 app 重签，可换标识"
     echo "  update   从 npm 拉新版本，热更新工具链（\"ipa update --check\" 只看不装）";;
esac

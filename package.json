{
  "name": "dsh-ipa-build",
  "version": "1.3.1",
  "description": "把 iOS 源码打成 .ipa 的 DSH 插件。包内自带 iPhoneOS 16.5 SDK 和 zsign，Windows / Linux / macOS 都能编能签，用户装完不用再配环境。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3783485207-cmd/dsh-ipa-build.git"
  },
  "keywords": [
    "dsh-plugin",
    "ipa",
    "ios",
    "packaging",
    "zsign",
    "ldid"
  ],
  "files": [
    "index.js",
    "cordis.patch.yml",
    "SKILL.md",
    "plugin.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "scripts",
    "vendor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}